# Caddy config for the front-end container.
#
# HTTPS is terminated by the reverse proxy in front of the container
# (Coolify's proxy), so this serves plain HTTP on 80 for any hostname.
# API_UPSTREAM is an environment variable, see the Dockerfile.

{
	admin off
	auto_https off
	persist_config off
}

:80 {
	encode gzip

	# Runtime settings, written by docker-entrypoint.sh
	handle /config.js {
		root * /run/mykomap
		file_server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# The app was served under /cwm/ on maps.coop, keep those links working.
	# handle_path strips the prefix so {uri} is the rest of the path plus the
	# query string, e.g. /cwm/?datasetId=powys-eng becomes /?datasetId=powys-eng
	rewrite /cwm /cwm/
	handle_path /cwm/* {
		redir * {uri} permanent
	}

	# MykoMaps v3 maps used to be served from the same server as v4
	# They are no longer but the iframe embeds on the other sites still
	#  point here - we redirect them from maps.coop/<map> to a new
	#  site for MykoMaps v3 maps - mm3.maps.coop
	# Temporary so browsers do not cache it and we can move it
	# Over time we will migrate these maps to point directly at the
	#  new site and then can remove these redirects
	# See coolify.md in techonology-and-infrastructure
	@v3Maps path /ica /ica/* /workers-coop /workers-coop/* /newbridge /newbridge/* /mersey-green /mersey-green/* /obo-public /obo-public/* /dotcoop /dotcoop/*
	redir @v3Maps https://mm3.maps.coop{uri} temporary

	handle {
		root * /usr/share/caddy
		file_server
	}
}
