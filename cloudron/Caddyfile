# Cloudron has a reverse proxy which teminates HTTPS
# We serve HTTP on 8000 (httpPort in CloudronManifest.json)

{
	admin off
	auto_https off
	persist_config off
}

:8000 {
	encode gzip

	# FE runtime settings - generated by start.sh
	handle /config.js {
		root * /run/mykomap
		file_server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /app/code/front-end
		file_server
	}
}
