{
  "name": "mykomap-monolith",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "bin": {
    "dataset": "apps/back-end/dist/dataset.js"
  },
  "files": [
    "apps/back-end/dist/dataset.js"
  ],
  "scripts": {
    "build": "npm run -w @mykomap/common build; npm run -w @mykomap/node-utils build; npm run --ignore-scripts -w @mykomap/back-end build; npm run --ignore-scripts -w @mykomap/front-end build",
    "clean": "npm run clean --workspaces && rimraf node_modules",
    "front-end:": "npm run --workspace=@mykomap/front-end",
    "back-end:": "npm run --workspace=@mykomap/back-end",
    "common:": "npm run --workspace=@mykomap/common",
    "node-utils:": "npm run --workspace=@mykomap/node-utils",
    "prettier:check": "prettier -cu --no-color .",
    "prettier:format": "prettier -wu --no-color .",
    "prepare": "npm run build",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "editorconfig": "^2.0.1",
    "rimraf": "^6.1.3"
  }
}
